---
import Branches from "../components/Branches.astro";
import ClientScroller from "../components/ClientScroller.astro";
---

<!DOCTYPE html>

<html class="scroll-smooth" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>National Logistics | Pioneer in Logistics Solutions</title>
<script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;family=JetBrains+Mono:wght@500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script is:inline id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary": "#ffffff",
                        "surface-tint": "#565e74",
                        "on-tertiary-container": "#d95f00",
                        "on-primary-fixed-variant": "#3f465c",
                        "on-tertiary-fixed": "#341100",
                        "on-primary": "#ffffff",
                        "error-container": "#ffdad6",
                        "surface-container-high": "#e6e8ea",
                        "outline-variant": "#c6c6cd",
                        "surface-bright": "#f7f9fb",
                        "surface-container": "#eceef0",
                        "tertiary-fixed": "#ffdbca",
                        "inverse-primary": "#bec6e0",
                        "tertiary-fixed-dim": "#ffb690",
                        "on-error": "#ffffff",
                        "outline": "#76777d",
                        "error": "#ba1a1a",
                        "inverse-on-surface": "#eff1f3",
                        "surface-variant": "#e0e3e5",
                        "surface": "#f7f9fb",
                        "surface-container-highest": "#e0e3e5",
                        "on-tertiary-fixed-variant": "#783200",
                        "tertiary": "#000000",
                        "tertiary-container": "#341100",
                        "on-secondary-fixed": "#0b1c30",
                        "primary-fixed": "#dae2fd",
                        "primary-container": "#131b2e",
                        "on-surface": "#191c1e",
                        "on-error-container": "#93000a",
                        "inverse-surface": "#2d3133",
                        "on-primary-fixed": "#131b2e",
                        "on-secondary-fixed-variant": "#38485d",
                        "on-secondary-container": "#54647a",
                        "surface-dim": "#d8dadc",
                        "background": "#f7f9fb",
                        "secondary-container": "#d0e1fb",
                        "secondary-fixed-dim": "#b7c8e1",
                        "surface-container-lowest": "#ffffff",
                        "primary": "#000000",
                        "on-primary-container": "#7c839b",
                        "on-secondary": "#ffffff",
                        "on-background": "#191c1e",
                        "on-surface-variant": "#45464d",
                        "primary-fixed-dim": "#bec6e0",
                        "secondary": "#505f76",
                        "surface-container-low": "#f2f4f6",
                        "secondary-fixed": "#d3e4fe"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "container-max": "1280px",
                        "margin-mobile": "16px",
                        "gutter": "24px",
                        "margin-desktop": "48px",
                        "base": "8px"
                    },
                    "fontFamily": {
                        "headline-lg-mobile": ["Inter"],
                        "headline-lg": ["Inter"],
                        "data-display": ["JetBrains Mono"],
                        "headline-xl": ["Inter"],
                        "body-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-md": ["Inter"],
                        "label-sm": ["JetBrains Mono"]
                    },
                    "fontSize": {
                        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "data-display": ["14px", {"lineHeight": "20px", "fontWeight": "600"}],
                        "headline-xl": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .industrial-grid {
            background-image: linear-gradient(to right, rgba(15, 23, 42, 0.05) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(15, 23, 42, 0.05) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        .industrial-shadow {
            box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.1), 0 2px 4px -2px rgba(15, 23, 42, 0.1);
        }
    </style>
</head>
<body class="bg-background text-on-surface font-body-md selection:bg-on-tertiary-container selection:text-white">
<!-- Top Navigation -->
<nav class="fixed top-0 z-50 w-full h-20 bg-white border-b border-outline-variant">
<div class="w-full h-full max-w-container-max mx-auto px-4 md:px-margin-desktop flex justify-between items-center">
<a href="#" class="flex items-center">
<img src="/logo.jpeg" alt="National Logistics" class="h-16 w-auto object-contain mix-blend-multiply" />
</a>
<div class="hidden md:flex items-center gap-6">
<a class="text-on-surface-variant hover:text-primary font-bold transition-colors" href="#about">About Us</a>
<a class="text-on-surface-variant hover:text-primary font-bold transition-colors" href="#service">Services</a>
<a class="text-on-surface-variant hover:text-primary font-bold transition-colors" href="#fleet">Fleet</a>
<a class="text-on-surface-variant hover:text-primary font-bold transition-colors" href="#network">Network</a>
<a class="bg-primary text-white px-6 py-2 rounded font-bold hover:brightness-110 transition-all" href="#contact">Contact</a>
</div>
</div>
</nav>
<main class="pt-20">
<!-- Hero Section -->
<section class="relative h-[80vh] w-full flex flex-col justify-center px-margin-mobile md:px-margin-desktop overflow-hidden">
<div class="absolute inset-0 z-0">
<img alt="" class="w-full h-full object-cover grayscale-[20%] brightness-50" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDF-uod47Cg1LNfSH76zmg6UKjQjQNe2W3-zuZkAMYgII1Igqtk5wXe38qlqzquLitPsMEM_zG60E2wmr9NRv-JP2EMRKkvVyoEfOPVtiMDPLJs1VH3RdMXmfrPeD52vrwvhOa9LrMIUgpwjcUG3eB8on4ExKViiwNRavhpaqppWc2mC_MRo2tvSKvG7YrlCRjSvgXy3QVhH2op3ubzQq1G8pdYHcR2A7Kn0kajXKQyGC7vRM38g0TYT1TuQszxYuE8W2r5oKaD09fQ"/>
<div class="absolute inset-0 bg-gradient-to-r from-primary-container/80 to-transparent"></div>
</div>
<div class="relative z-10 max-w-2xl">
<p class="font-label-sm text-label-sm text-on-tertiary-container tracking-[0.2em] mb-4 uppercase">EST. 1982</p>
<h1 class="font-headline-xl text-headline-xl text-white mb-2 leading-none">NATIONAL LOGISTICS</h1>
<h2 class="font-headline-md text-headline-md-mobile text-white/80 font-light mb-8 italic">PIONEER IN LOGISTICS SOLUTIONS</h2>
<div class="flex flex-col sm:flex-row gap-4">
<a href="#contact"
    <button  class="border border-white/30 backdrop-blur-md bg-white/10 text-white px-8 py-4 font-label-sm text-label-sm uppercase hover:bg-white/20 transition-all">Request Quote</button>
</a>
</div>
</div>
<!-- Grid overlay for technical feel -->
<div class="absolute inset-0 industrial-grid pointer-events-none opacity-20"></div>
</section>
<!-- Leadership Introduction -->
<section id="about" class="py-16 md:py-24 bg-surface px-margin-mobile md:px-margin-desktop scroll-mt-20">
<div class="max-w-container-max mx-auto">
<div class="mb-16">
<span class="font-label-sm text-label-sm text-on-primary-container uppercase">The Legacy</span>
<h2 class="font-headline-lg text-headline-lg-mobile text-primary mt-2">Excellence in Motion Since 1982</h2>
<div class="h-1 w-20 bg-on-tertiary-container mt-4"></div>
<p class="mt-8 font-body-lg text-body-lg text-on-surface-variant max-w-3xl">
                        Since 1982, National Logistics has transitioned from a regional transporter into an integrated infrastructure powerhouse. Serving high-repute government and private clients, we manage cargo movement globally with an active fleet of 350+ specialized vehicles.
                    </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
<!-- Leader 1 -->
<div class="bg-white border border-outline-variant p-8 industrial-shadow hover:translate-y-[-4px] transition-transform duration-300">
<div class="w-16 h-16 bg-surface-container rounded-full flex items-center justify-center mb-6">
<span class="material-symbols-outlined text-primary text-3xl" data-icon="person_filled">person</span>
</div>
<h3 class="font-headline-md text-headline-md-mobile text-primary">Mr. Prem Agarwal</h3>
<p class="font-label-sm text-label-sm text-on-tertiary-container mb-4">FOUNDER &amp; CHAIRMAN</p>
<p class="text-on-surface-variant">A visionary with over 36 years of logistics experience. He brings deep industry expertise, specializing in everything from normal cargo to complex ODC consignments.</p>
</div>
<!-- Leader 2 -->
<div class="bg-white border border-outline-variant p-8 industrial-shadow hover:translate-y-[-4px] transition-transform duration-300">
<div class="w-16 h-16 bg-surface-container rounded-full flex items-center justify-center mb-6">
<span class="material-symbols-outlined text-primary text-3xl" data-icon="person_filled">person</span>
</div>
<h3 class="font-headline-md text-headline-md-mobile text-primary">Mr. Vaibhav Agarwal</h3>
<p class="font-label-sm text-label-sm text-on-tertiary-container mb-4">MANAGING DIRECTOR</p>
<p class="text-on-surface-variant">Leveraging more than 10 years of experience to introduce a new set of values, high service standards, and complete logistics solutions to our clients.</p>
</div>
<!-- Leader 3 -->
<div class="bg-white border border-outline-variant p-8 industrial-shadow hover:translate-y-[-4px] transition-transform duration-300">
<div class="w-16 h-16 bg-surface-container rounded-full flex items-center justify-center mb-6">
<span class="material-symbols-outlined text-primary text-3xl" data-icon="person_filled">person</span>
</div>
<h3 class="font-headline-md text-headline-md-mobile text-primary">Mr. Vibhor Agarwal</h3>
<p class="font-label-sm text-label-sm text-on-tertiary-container mb-4">DIRECTOR OF OPERATIONS</p>
<p class="text-on-surface-variant">Optimizing operational momentum and vehicle procurement to seamlessly support our massive fleet of multi-axle trailers, containers, and tankers.</p>
</div>
</div>
</div>
</section>
<!-- Philosophy & Mission -->
