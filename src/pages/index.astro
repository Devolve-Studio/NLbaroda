<h4 class="font-label-sm text-label-sm mb-2 uppercase">Scalability</h4>
<div class="h-[1px] w-8 bg-on-tertiary-container mb-4"></div>
</div>
</div>
</div>
</section>
<!-- Core Values Bento -->
<section class="py-16 px-margin-mobile md:px-margin-desktop bg-surface-low">
<div class="max-w-container-max mx-auto">
<h2 class="font-headline-md text-headline-md-mobile text-primary mb-8 border-l-4 border-on-tertiary-container pl-4">Institutional Values</h2>
<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
<div class="md:col-span-8 bg-white border border-outline-variant p-8 flex flex-col justify-between industrial-shadow">
<div>
<span class="material-symbols-outlined text-primary text-4xl mb-4" data-icon="auto_awesome">auto_awesome</span>
