---
const stats = [
    { number: "99.8%", label: "On-Time Delivery", icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>` },
    { number: "10K+", label: "Secure Handling", icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>` },
    { number: "24/7", label: "Global Support", icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>` },
];
---
<section id="stats" class="py-20 bg-blue-900 text-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 reveal opacity-0 translate-y-8 transition-all duration-700">
            <h2 class="text-3xl font-bold mb-4">Why Choose Us</h2>
            <p class="text-blue-200">The pillars of our logistical success.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
            {stats.map((stat, index) => (
                <div class="p-6 reveal opacity-0 scale-95 transition-all duration-700" style={`transition-delay: ${index * 200}ms`}>
                    <div class="flex justify-center mb-4 text-orange-400" set:html={stat.icon} />
                    <div class="text-5xl font-extrabold mb-2">{stat.number}</div>
                    <div class="text-lg text-blue-200 font-medium">{stat.label}</div>
                </div>
            ))}
        </div>
    </div>
</section>
