---
---
<style>
    @keyframes sharp-blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
    .animate-sharp-blink {
        animation: sharp-blink 1s step-end infinite;
    }
</style>

<section class="relative min-h-screen flex items-center pt-16 bg-gradient-to-br from-blue-100 via-blue-50 to-sky-100 overflow-hidden">

    <div class="absolute inset-0 opacity-5 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-500 to-transparent"></div>

    <div class="absolute top-0 left-0 w-1/2 max-w-[500px] md:max-w-[700px] -translate-x-24 -translate-y-64 pointer-events-none z-0 reveal opacity-0 -rotate-20 transition-all duration-1000 delay-500">
        <img
                src="/tyre.png"
                alt="Logistics background"
                class="w-full h-auto object-contain select-none"
        />
    </div>

    <div class="absolute bottom-0 right-0 w-1/2 max-w-[500px] md:max-w-[700px] translate-x-65 translate-y-50 pointer-events-none z-0 reveal opacity-0 rotate-20 transition-all duration-1000 delay-500">
        <img
                src="/tyre.png"
                alt="Logistics background"
                class="w-full h-auto object-contain select-none"
        />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full text-center md:text-left">
        <div class="max-w-3xl">
            <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-[#273662] leading-tight reveal opacity-0 translate-y-8 transition-all duration-1000">
                Driving Your Business Forward with <span class="text-[#f98927]">Precision</span>.<span class="inline-block w-[4px] h-[0.9em] bg-[#f98927] align-middle ml-1 -mt-2 animate-sharp-blink"></span>
            </h1>

            <p class="mt-6 text-xl text-slate-600 reveal opacity-0 translate-y-8 transition-all duration-1000 delay-200">
                Experience reliable, efficient, and secure logistics solutions tailored to keep your supply chain moving globally.
            </p>
        </div>
    </div>
</section>