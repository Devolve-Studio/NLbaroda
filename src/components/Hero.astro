---
<section class="relative min-h-screen flex items-center pt-16 bg-gradient-to-br from-slate-50 via-white to-blue-50 overflow-hidden">

    <div class="absolute inset-0 opacity-5 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-500 via-transparent to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full text-center md:text-left">
        <div class="max-w-3xl">
            <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-slate-900 leading-tight reveal opacity-0 translate-y-8 transition-all duration-1000">
                Driving Your Business Forward with <span class="text-orange-500">Precision</span>.
            </h1>

            <p class="mt-6 text-xl text-slate-600 reveal opacity-0 translate-y-8 transition-all duration-1000 delay-200">
                Experience reliable, efficient, and secure logistics solutions tailored to keep your supply chain moving globally.
            </p>

            <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center md:justify-start reveal opacity-0 translate-y-8 transition-all duration-1000 delay-400">
                <a href="#services" class="px-8 py-4 bg-orange-500 hover:bg-orange-600 text-white font-bold rounded-lg shadow-lg hover:shadow-orange-500/30 transition-all text-lg">
                    Our Services
                </a>

                <a href="#contact" class="px-8 py-4 bg-white hover:bg-slate-50 text-slate-800 font-bold rounded-lg shadow-sm border border-slate-200 transition-all text-lg">
                    Contact Us
                </a>
            </div>
        </div>
    </div>
</section>